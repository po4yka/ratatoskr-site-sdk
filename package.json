{
  "name": "@ratatoskr/site-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Types and a starter template for a site that reads a Ratatoskr release through the Content Delivery API.",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "contracts:check": "node scripts/check-contracts.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "happy-dom": "20.14.6",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
